<IfModule mod_rewrite.c>
    RewriteEngine On
    # Allow existing files and directories (static images, CSS, JS) to be served directly
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    # Rewrite all other URLs to index.php in the current directory
    RewriteRule ^(.*)$ index.php [QSA,L]
</IfModule>
